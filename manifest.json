{
  "manifest_version": 3,
  "name": "PipMouse — the pet that eats your distractions",
  "short_name": "PipMouse",
  "version": "2.1.0",
  "description": "Plan a task and a cartoon mouse moves into your browser, nibbling every website you visit until you get it done.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PipMouse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "dashboard.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}